{
  "name": "@bps/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --external=elysia --outdir=dist && bun -e \"await import('./dist/index.js')\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "storage:setup": "bun src/storage/setup.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@bps/shared": "workspace:*",
    "@elysiajs/cors": "latest",
    "@supabase/supabase-js": "2.117.3",
    "drizzle-orm": "0.45.4",
    "elysia": "latest",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11"
  }
}
